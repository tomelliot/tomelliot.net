# Copy to .env next to docker-compose.yml. Every value here is a secret except
# the last two; keep the file out of git.

# Immich → Account Settings → API Keys. Needs read access to assets and tags.
IMMICH_API_KEY=

# Cloudflare → R2 → Manage API tokens → Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tomelliot-photos
# Optional key prefix inside the bucket, if it holds more than this gallery.
R2_PREFIX=

# The public URL the bucket is served from, with no trailing slash. Attach a
# custom domain to the bucket in the R2 dashboard; the r2.dev development URL
# is rate limited and not meant for production.
PHOTO_BASE_URL=https://photos.tomelliot.net

# SSH remote, so the mounted deploy key authenticates the push.
REPO_URL=git@github.com:tomelliot/tomelliot.net.git

# Shared with the Immich workflow's webhook header. Generate one with:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# Set to true to run the whole pipeline and print the diff without pushing.
SYNC_DRY_RUN=false
